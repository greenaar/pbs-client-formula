# File managed by Salt. Do not edit by hand.
# Mode 0600, root:root -- contains PBS credentials.
{%- from "pbs-client/map.jinja" import config with context %}
export PBS_REPOSITORY={{ config.repository | quote }}
export PBS_PASSWORD={{ config.password | quote }}
{%- if config.fingerprint %}
export PBS_FINGERPRINT={{ config.fingerprint | quote }}
{%- endif %}
